// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  idUser        Int         @id @default(autoincrement())
  nome          String
  email         String  @unique
  senha         String
  cpf           String  @unique
  estabelecimento Estabelecimento[]

  colaborador     Colaborador[]


  @@map("user")
}

model Estabelecimento {
  idEstabelecimento   Int           @id @default(autoincrement())
  dono                Int
  User                User          @relation(fields: [dono], references: [idUser])
  nome                String
  cnpj                String        @unique
  idEndereco          Int
  Endereco            Enderecos     @relation(fields: [idEndereco], references: [idEndereco])

  colaborador Colaborador[]

  horariosDisponiveis horariosDisponiveis[]

  @@map("estabelecimento")
}

model Agendamentos {
  idAgendamento   Int @id @default(autoincrement())

  idHorario       Int
  horariosDisponiveis horariosDisponiveis @relation(fields: [idHorario], references: [idHorario])

  @@map("agendamentos")
}

model horariosDisponiveis {
  idHorario Int @id @default(autoincrement())

  dataHora          DateTime

  ocupado           Boolean

  minutosDuracao    Int

  idEstabelecimento Int
  Estabelecimento   Estabelecimento @relation(fields: [idEstabelecimento], references: [idEstabelecimento])
  
  idColaborador     Int
  Colaborador       Colaborador @relation(fields: [idColaborador], references: [idColaborador])

  agendamentos Agendamentos[]

  @@map("horariosDisponiveis")


}

model Colaborador {
  idColaborador       Int       @id @default(autoincrement())
  dataEmissao         DateTime      

  idEstabelecimento   Int
  Estabelecimento     Estabelecimento @relation(fields: [idEstabelecimento], references: [idEstabelecimento])

  idUser              Int
  User                User            @relation(fields: [idUser], references: [idUser])
  
  horariosDisponiveis horariosDisponiveis[]

  @@map("colaborador")
}

model Enderecos {
  idEndereco    Int   @id @default(autoincrement())
  cep           String
  cidade        String
  bairro        String
  rua           String

  estabelecimento Estabelecimento[]


  @@map("enderecos")

}
